# =============================================================================
# Sinsap: environment variables (copy to .env.local and fill in)
# Every value here is read on the SERVER only. Never prefix secrets with NEXT_PUBLIC_.
# =============================================================================

# --- Database: choose ONE --------------------------------------------------------
# A) Google Sheets (see docs/DEPLOY-GOOGLE-SHEETS.md)
#    The spreadsheet must be shared (Editor) with the service account e-mail.
GOOGLE_SHEETS_ID=
#    Whole service-account key file (raw JSON or base64) ...
GOOGLE_SERVICE_ACCOUNT_JSON=
#    ... or the two fields separately:
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# SHEETS_FRESHNESS_MS=2000        # how long a server trusts its copy before re-checking the sheet
#
# B) PostgreSQL 15+ (Supabase, Neon, self-hosted). Takes priority over Google Sheets.
#    Supabase on Vercel: use the "Transaction pooler" string (port 6543).
DATABASE_URL=
#
# C) Neither set = local mode: embedded PostgreSQL (PGlite) stored in ./.data/pglite.
#    Fine for one computer; NOT for multi-device use or for Vercel.
# DATABASE_POOL_MAX=5
# DATABASE_SSL=require            # require (default) | no-verify | disable
# AUTO_MIGRATE=false              # true = apply migrations on server start (default: run `npm run db:migrate`)
# PGLITE_DATA_DIR=.data/pglite    # local mode only; "memory" = throw-away database

# --- App ---------------------------------------------------------------------
# Public base URL, used in password-reset links.
APP_URL=http://localhost:3000
# Self-hosting on several instances: a stable key shared by all of them (Vercel sets this for you).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- E-mail for password reset (https://resend.com) --------------------------
# Not set: outside production the reset link is printed to the server console;
# in production use `npm run auth:reset-link -- <email>` as the operator.
RESEND_API_KEY=
EMAIL_FROM=

# --- Market data (at least one key to get prices automatically) --------------
# US stocks/ETFs: Twelve Data free plan works (8 req/min, 800/day).
# Thai SET stocks: EODHD paid plan ("EOD Historical Data: All World") or Twelve Data Pro.
TWELVEDATA_API_KEY=
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=
# Which provider serves which market (default: first one with a key, in this order)
# MARKET_PROVIDER_US=twelvedata   # twelvedata | eodhd | alphavantage
# MARKET_PROVIDER_TH=eodhd        # eodhd | twelvedata
# Request budgets enforced by the app (defaults match the free plans)
# TWELVEDATA_PER_MINUTE=8
# TWELVEDATA_PER_DAY=800
# EODHD_PER_MINUTE=20
# EODHD_PER_DAY=20
# ALPHAVANTAGE_PER_MINUTE=5
# ALPHAVANTAGE_PER_DAY=25
# Quote refresh policy
# QUOTE_TTL_OPEN_MINUTES=15       # while the market is open
# QUOTE_RETRY_MINUTES=60          # minimum gap between attempts while closed / after a failure
# Labels for paid entitlements (only set if your plan really includes them)
# TWELVEDATA_DATA_TYPE=realtime   # realtime | delayed
# ALPHAVANTAGE_ENTITLEMENT=       # realtime | delayed  (Alpha Vantage premium)
# ALPHAVANTAGE_PREMIUM=false      # true = request full daily history

# --- Exchange rates ----------------------------------------------------------
# Frankfurter needs no key. Override only if you self-host it.
# FX_API_BASE=https://api.frankfurter.dev
